{
  "name": "case-itau-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "export NODE_OPTIONS=\"--openssl-legacy-provider\" && ng serve",
    "build": "export NODE_OPTIONS=\"--openssl-legacy-provider\" && ng build",
    "watch": "export NODE_OPTIONS=\"--openssl-legacy-provider\" && ng build --watch --configuration development",
    "test": "export NODE_OPTIONS=\"--openssl-legacy-provider\" && ng test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.3.0",
    "@angular/common": "^14.3.0",
    "@angular/compiler": "^14.3.0",
    "@angular/core": "^14.3.0",
    "@angular/forms": "^14.3.0",
    "@angular/platform-browser": "^14.3.0",
    "@angular/platform-browser-dynamic": "^14.3.0",
    "@angular/router": "^14.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "rxjs": "~6.6.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.13",
    "@angular/cli": "^14.2.13",
    "@angular/compiler-cli": "^14.3.0",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/jest": "^29.2.6",
    "@types/node": "^12.11.1",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "jest": "^27.5.1",
    "jest-preset-angular": "^11.1.2",
    "protractor": "~7.0.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~4.6.4"
  }
}